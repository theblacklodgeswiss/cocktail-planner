rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Super Admin email - can only manage users, not data
    function isSuperAdmin() {
      return hasEmail() && authEmail() == 'the.blacklodge@outlook.com'.lower();
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function hasEmail() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Check if user is admin via allowedUsers collection
    function isAdminFromCollection() {
      return hasEmail() &&
             exists(/databases/$(database)/documents/allowedUsers/$(authEmail())) &&
             get(/databases/$(database)/documents/allowedUsers/$(authEmail())).data.isAdmin == true;
    }

    // Check if user is on the employees roster via the employeeAccess mirror
    function isRosteredEmployee() {
      return hasEmail() &&
             exists(/databases/$(database)/documents/employeeAccess/$(authEmail()));
    }

    // Admin, super admin, or a rostered employee: full order access
    function hasFullOrderAccess() {
      return isSuperAdmin() || isAdminFromCollection() || isRosteredEmployee();
    }
    
    // Full data admin (NOT including super admin)
    function isAdmin() {
      return isAdminFromCollection();
    }

    // Can manage users: full admin OR super admin
    function canManageUsers() {
      return isSuperAdmin() || isAdminFromCollection();
    }
    
    // Authenticated users (including anonymous)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOrderOwner() {
      return request.auth != null && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.get('createdBy', '') == request.auth.token.email ||
          resource.data.get('userEmail', '') == request.auth.token.email
        ))
      );
    }
    
    // Materials collection
    match /materials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Recipes collection
    match /recipes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Fixed values collection
    match /fixedValues/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Additional services catalog - readable by anyone (including
    // anonymous customers filling out the order form), writable only by
    // admins who can manage the catalog.
    match /additionalServices/{document=**} {
      allow read: if true;
      allow write: if canManageUsers();
    }

    // Orders collection - owner or employee-or-higher can read/write; create
    // requires the caller to be the resource's own userId.
    match /orders/{orderId} {
      allow read: if isOrderOwner() || hasFullOrderAccess();
      // Note: previously required request.resource.data.userId ==
      // request.auth.uid to prevent create-time uid spoofing, but this
      // blocked legitimate guest submissions in production (2026-09-15) -
      // reverted to the original, unconditional-for-authenticated-users
      // check while the exact cause of the mismatch is investigated.
      allow create: if isAuthenticated();
      allow update, delete: if isOrderOwner() || hasFullOrderAccess();
    }
    
    // Users collection - for user profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Allowed users collection - super admin can create; full admins can create/update/delete
    match /allowedUsers/{email} {
      allow read: if canManageUsers() || (hasEmail() && email == authEmail());
      allow create, update, delete: if canManageUsers();
    }
    
    // Admin config - only admin can read/write
    match /config/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Settings collection - all authenticated can read, only admin can write
    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Employees collection - users who can manage users can read/write
    match /employees/{document=**} {
      allow read: if isAuthenticated();
      allow write: if canManageUsers();
    }

    // employeeAccess mirror - existence grants order access. Write is
    // admin-only so the tier cannot be self-granted; read is limited to the
    // owner's own doc plus admins, so it is not a staff directory readable
    // by every customer.
    match /employeeAccess/{email} {
      allow read: if canManageUsers() || (hasEmail() && email == authEmail());
      allow write: if canManageUsers();
    }

    // Share links - short-lived, publicly readable links to a frozen
    // snapshot of an offer/invoice for external (signed-out) recipients.
    // Read has no auth check by design: the recipient clicking a WhatsApp
    // link has no Firebase session. The expiresAt check is the entire
    // security boundary. Documents are write-once (no update/delete).
    match /shareLinks/{code} {
      allow read: if resource.data.expiresAt > request.time;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Microsoft Forms collection - authenticated users can read/write
    match /microsoftForms/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Gemini usage tracking - authenticated can read, admin can write
    match /gemini_usage/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Historical shopping lists (imported from OneDrive)
    match /historical_shopping_lists/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
